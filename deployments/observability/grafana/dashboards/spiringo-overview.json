{
  "uid": "spiringo-overview",
  "title": "Spiringo Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["spiringo"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spiringo_http_requests_total[5m])) by (method, path, status)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Latency Summary",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spiringo_http_request_duration_seconds_sum[5m])) / sum(rate(spiringo_http_request_duration_seconds_count[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Event Handler Errors",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spiringo_event_handler_errors_total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Queue Task Errors",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spiringo_queue_task_errors_total)"
        }
      ]
    }
  ]
}
